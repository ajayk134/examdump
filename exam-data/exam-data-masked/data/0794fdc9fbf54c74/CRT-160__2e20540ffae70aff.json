        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Use a completion action on the form to automatically add anyone who completes it to the list."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Use a dynamic list that matches prospects as they complete the form."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Use an automation rule where prospects who complete the form will match the rule once and be added to the list."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Use table actions to add prospects who have completed the form to the list."
            }
          ]
        }
      },
      "Answer": {
        "content": [
