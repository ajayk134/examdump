        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Ask open-ended questions staying away from questions regarding feelings"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Ask specific questions about known pain points to confirm your hypothesis"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Ask users to explore the application without specific questions regarding which tasks to perform"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
