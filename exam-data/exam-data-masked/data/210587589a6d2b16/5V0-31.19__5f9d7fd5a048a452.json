      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An administrator wants to enable a VMware Cloud on AWS SDDC to interoperate with an on-premises SDDC."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "How this is achieved?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Use the SDDC console to configure the IPSEC VPN connection between the VMware Cloud on AWS and on-premises vSphere SDDC."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Specify the static IP address of the on-premises SDDC when initially requesting a new VMware Cloud on AWS SDDC."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Use the AWS management Console to configure the connection between the VMware Cloud on AWS and on-premises vSphere SDDC."
            }
