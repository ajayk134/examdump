        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Appending the new value to the associated Memcached Key manually"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Placing SSH into the Memcached node and running purge_all"
