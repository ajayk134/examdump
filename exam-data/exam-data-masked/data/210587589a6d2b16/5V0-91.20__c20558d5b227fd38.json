    "Question #: 2": {
      "Title": "Exam 5V0-91.20 topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An administrator observes the following event detail in the Investigate tab for an application with an unknown reputation making network connections:"
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://www.examtopics.com/assets/media/exam-media/03920/0000500001.jpg"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Upon further review of the event details returned, the reputation is observed as NOT_LISTED, and the applied (cloud) reputation is UNKNOWN."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Why is the applied (cloud) reputation UNKNOWN and not NOT_LISTED?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The sensor demoted the local reputation from UNKNOWN to NOT_LISTED based on the coud reputation."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. NOT_LISTED was applied by the sensor after observing no cloud reputation, as evidenced by the applied cloud reputation UNKNOWN."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The application was UNKNOWN at the time of the event but then later determined to be NOT_LISTED."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The sensor demoted the local reputation from NOT_LISTED to UNKNOWN based on the cloud reputation."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "B",
          "vote_count": 2,
          "is_most_voted": true
        }
      ]
    },
