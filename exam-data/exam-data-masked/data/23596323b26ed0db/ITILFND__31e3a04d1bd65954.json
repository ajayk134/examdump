      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A known error has been created after diagnosis of a problem was complete but before a workaround has been found. Is this a valid approach?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Yes: for information purposes, a known error record can be created at any time it is prudent to do so"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. No: the Known Error should be created before the problem is logged"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. No: a known error record is created when the original incident is raised"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. No: a known error record should be created with the next release of the service"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
