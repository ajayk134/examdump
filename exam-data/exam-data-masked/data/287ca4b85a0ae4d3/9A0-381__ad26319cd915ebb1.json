      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You activate an alert on a Hotel Properties report with the intent of being notified whenever the bookings for a particular hotel property change by 10%. The alert is set to assess changes to the hotels bookings at the end of every week. Half way through the week the hotel receives an 11% increase in bookings."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "How will you be notified you of the activity?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. You will receive an alert at the end of the week when the alert runs provide the change for the week is at least 10%"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. You will receive an alert shortly after the traffic responsible for the spike is processed which should be less then 90 minutes"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. You will NOT be alerted because there was an increase in booking and not a decrease"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. You will NOT be alerted because the change in booking is not precisely 10%"
            }
          ]
