          "content": [
            {
              "type": "text",
              "value": "B. Configure replication agents for the author pointing to publ, pub2 and pub3."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Configure reverse replication agents for the author pointing to publ, pub2 and pub3."
