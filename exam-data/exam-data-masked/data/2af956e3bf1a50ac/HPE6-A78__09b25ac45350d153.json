      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A client is connected to a Mobility Controller (MC). These firewall rules apply to this client\u2019s role: ipv4 any any svc-dhcp permit ipv4 user 10.1.5.20 svc-dns permit ipv4 user 10.1.1.0 255.255.255.0 https permit ipv4 user 10.1.0.0 255.255.0.0 https deny_opt ipv4 user any any permit"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What correctly describes how the controller treats HTTPS packets to these two IP addresses, both of which are on the other side of the firewall:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "10.1.20.1"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "10.1.5.20"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Both packets are permitted."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Both packets are denied."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The first packet is denied, and the second is permitted."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The first packet is permitted, and the second is denied."
            }
          ]
        }
