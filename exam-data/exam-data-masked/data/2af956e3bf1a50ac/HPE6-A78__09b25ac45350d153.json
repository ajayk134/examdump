    "Question #: 2": {
      "Title": "Exam HPE6-A78 topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A client has accessed an HTTPS server at myhost1.example.com using Chrome. The server sends a certificate that includes these properties:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "* Subject name: myhost1.example.com"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "* SAN: DNS: myhost.example.com"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "* Extended Key Usage (EKU): Server authentication"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "* Issuer: MyCA_Signing"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The server also sends an intermediate CA certificate for MyCA_Signing which is signed by MyCA. The client\u2019s Trusted CA Certificate list includes MyCA but not MyCA_Issuing."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which factor or factors prevent the client from trusting the certificate?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The certificate lacks a valid SAN."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The client does not have the correct trusted CA certificates."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The certificate lacks the correct EKU."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The certificate lacks a valid SAN, and the client does not have the correct trusted CA certificates."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
