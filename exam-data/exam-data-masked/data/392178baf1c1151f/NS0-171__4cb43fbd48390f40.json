          "content": [
            {
              "type": "text",
              "value": "A. Set the DataMover. HardwareAcceleratedInit advanced setting to 0 on the ESXi host."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Enable VMware vStorage for NFS on the NetApp SVM."
            }
          ]
        },
