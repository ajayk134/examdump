    "Question #: 4": {
      "Title": "Exam QSDA2024 topic 1 question 13 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A data architect needs to write the expression for a measure on a KPI to show the sales person with the highest sales. The sort order of the values of the fields is unknown. When two or more sales people have sold the same amount, the expression should return all of those sales people."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which expression should the data architect use?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Concat(DISTINCT IF(Aggr(Rank(Sum(Sales),4),SalesPerson)=1,SalesPerson),' ')"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. FirstSortedValue(DISTINCT SalesPerson,-Aggr(Sum(Sales),SalesPerson))"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. FirstSortedValue(SalesPerson,-Aggr(Sum(Sales),SalesPerson))"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Concat(DISTINCT IF(Aggr(Rank(Sum(Sales),1),SalesPerson)=1,SalesPerson),' ')"
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "D",
          "vote_count": 1,
          "is_most_voted": false
        },
        {
          "voted_answers": "A",
          "vote_count": 1,
          "is_most_voted": true
        }
      ]
    },
