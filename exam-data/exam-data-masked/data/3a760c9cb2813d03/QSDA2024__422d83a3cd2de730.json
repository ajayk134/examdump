    "Question #: 8": {
      "Title": "Exam QSDA2024 topic 1 question 26 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Refer to the exhibit."
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://img.examtopics.com/qsda2024/image26.png"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "A system creates log files and csv files daily and places these files in a folder. The log files are named automatically by the source system and change regularly. All csv files must be loaded into Qlik Sense for analysis."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which method should be used to meet the requirements?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. SET vFileList = 'Day1','Day2','Day3';"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "FOR EACH vFile in $(vFileList)"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "LOAD * FROM [lib://Data (User1) /multi/$(vFile).csv];"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "NEXT"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. LOAD *"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "FROM [lib://Data (User1)/multi/*]"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "(csv);"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. LOAD *"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "FROM [lib://Data (User1)/multi/*]"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "(txt)"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. SET vLib = chr(39) & 'lib://Data (User1)/multi/*.csv' & chr(39);"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "FOR EACH File in filelist($(vLib))"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "LOAD * FROM [$(File)];"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "NEXT"
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
