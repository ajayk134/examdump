      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. A deadlock cannot occur in Snowflake, since concurrently executed queries and DML statements do not block one another."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. If two queries are concurrently executed against the same table, one of the two queries will be blocked until the other query completes."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Transaction locking in Snowflake is enforced exclusively at the row and table levels."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Queries executed within a given transaction see that transaction's uncommitted changes."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
