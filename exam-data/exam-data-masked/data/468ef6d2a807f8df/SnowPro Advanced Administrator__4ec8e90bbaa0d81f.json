          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The Administrator now wants to disable the managed access on the schema."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "How can this be accomplished?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. ALTER SCHEMA SCHEMA_MANAGED_ACCESS DISABLE MANAGED ACCESS;"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. USE ROLE ROLE_MANAGED_ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "DROP SCHEMA WORK.SCHEMA_MANAGED_ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "CREATE SCHEMA SCHEMA_MANAGED_ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "Then recreate all needed objects."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. REVOKE SELECT, INSERT ON FUTURE TABLES IN SCHEMA SCHEMA_MANAGED_ACCESS FROM"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "ROLE MANAGED ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "ALTER SCHEMA SCHEMA_MANAGED_ACCESS DISABLE MANAGED ACCESS;"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. USE ROLE ROLE_MANAGED_ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "DROP SCHEMA WORK.SCHEMA_MANAGED_ACCESS;"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "CREATE SCHEMA SCHEMA_MANAGED_ACCESS WITHOUT MANAGED ACCESS;"
            },
            {
