    "Question #: 8": {
      "Title": "Exam SnowPro Advanced Administrator topic 1 question 17 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A Snowflake Administrator created a role ROLE_MANAGED_ACCESS and a schema SCHEMA_MANAGED_ACCESS as follows:"
