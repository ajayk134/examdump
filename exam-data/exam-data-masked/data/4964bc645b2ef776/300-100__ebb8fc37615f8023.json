    "Question #: 1": {
      "Title": "Exam 300-100 topic 1 question 5 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "In order to generate an individual log file for each of the machines connecting to a Samba server, which of the following statements must be used in the Samba configuration file?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. log file = /var/log/samba/log.%c"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. log file = /var/log/samba/log.%M"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. log file = /var/log/samba/log.%m"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. log file = /var/log/samba/log.%I"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "C",
          "vote_count": 1,
          "is_most_voted": true
        }
      ]
    },
    "Question #: 2": {
