    "Question #: 6": {
      "Title": "Exam 300-100 topic 1 question 26 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What is the true of the following share's access properties? (Choose two.)"
          },
          {
            "type": "break"
          },
