        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. @managers copies the permissions of the share [managers]."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The alice and bob users can manipulate files regardless of the file system permissions."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. @managers will be resolved as a Unix group."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. @managers is a builtin default Samba group."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. the parameter admin users can be applied only to print shares."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
