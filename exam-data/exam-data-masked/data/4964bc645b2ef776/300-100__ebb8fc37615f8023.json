            {
              "type": "text",
              "value": "A. global charset = ASCII"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. unicode = no"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. ASCII = yes"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. force charset = ASCII"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. reduce charset = yes"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
