    "Question #: 6": {
      "Title": "Exam 303-200 topic 1 question 9 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which of the following are differences between AppArmor and SELinux? (Choose TWO correct answers)."
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. AppArmor is implemented in user space only. SELinux is a Linux Kernel Module."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. AppArmor is less complex and easier to configure than SELinux."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. AppArmor neither requires nor allows any specific configuration. SELinux must always be manually configured."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. SELinux stores information in extended file attributes. AppArmor does not maintain file specific information and states."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The SELinux configuration is loaded at boot time and cannot be changed later on. AppArmor provides user space tools to change its behavior."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: BD \ud83d\uddf3\ufe0f"
