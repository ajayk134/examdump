      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. -drive bus=ide1,type=slave,image=file.img"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. -drive image=file.img,if=ide,device=hdb"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. -drive bus=hd,busid=b,src=file.img"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. -drive file=file.img,index=1,media=disk,if=ide"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. -drive type=loop,src=file.img,dst=disk:hdb"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
