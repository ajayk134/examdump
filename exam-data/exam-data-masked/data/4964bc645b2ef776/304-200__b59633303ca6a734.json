    "Question #: 9": {
      "Title": "Exam 304-200 topic 1 question 72 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What is the effect of running the virsh vcpupin CLUSNODE-2 4 2 command?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. It sets the affinity of virtual CPU 4 of virtual machine CLUSNODE-2 to physical processor 2."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. It reduces the number of virtual CPUs in CLUSNODE-2 from 4 to 2."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It increases the number of virtual CPUs in CLUSNODE-2 from 2 to 4."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It sets the affinity for all virtual CPUs of virtual machine CLUSNODE-2 to the physical processors 2 and 4."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
    "Question #: 10": {
      "Title": "Exam 304-200 topic 3 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "When using DRBD in a Pacemaker cluster, which configuration objects must be managed in order to use the DRBD device as storage for other cluster services?"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "(Choose TWO correct answers.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. A security resource in order to permit other cluster services to access the data on the DRBD device."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. A health resource in order to check the integrity of the file system."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. A file system resource to mount the device."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. A replication resource that synchronizes the DRBD device's data to all nodes that may take over the device after a failover."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. A constraint to ensure the device is mounted before the dependent services are started."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: CE \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    }
