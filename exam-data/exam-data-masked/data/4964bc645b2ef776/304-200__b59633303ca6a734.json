        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Virtual Machines must use a SOCKS proxy to connect to the internet."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Virtual Machines can communicate with the host system and with other virtual machines using User Network."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Virtual Machines can only communicate with other virtual machines but not with the host system."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Virtual Machines cannot use ICMP."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Virtual Machines are restricted to only use IPv6 and not IPv4."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
