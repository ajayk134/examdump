      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What action does the virsh restore command perform?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. It restores a virtual machine that was stopped by a kernel panic."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. It restores a virtual machine from a state file."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It reverts a virtual machine, including its storage devices, to a previously saved state."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It wakes up a virtual machine that was hibernated by the operating system running inside the virtual machine."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
