          {
            "type": "text",
            "value": "A BIG-IP Administrator creates a new Virtual Server to load balance SSH traffic. Users are unable to log on to the servers."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should the BIG-IP Administrator do to resolve the issue?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Set Source Address to 10.1.1.2"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Set Destination Addresses/Mask to 0.0.0.0/0"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Set Protocol to UDP"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Set HTTP Profile to None"
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
