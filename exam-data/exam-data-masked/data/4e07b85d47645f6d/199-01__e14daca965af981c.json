    "Question #: 6": {
      "Title": "Exam 199-01 topic 1 question 57 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A customer's network consists of a data center with an Interceptor appliance and a Steelhead appliance cluster and several remote sites each with Steelhead appliances."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You would like to pass-through an application unoptimized due to a suspected problem and are provided the following information:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The application uses a static TCP port, 15000."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The application is initiated from the remote site machines."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The same servers which host the application host several other applications as well."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Based on the information provided which option will allow the application to pass-through:"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Configure in-path rules on the Interceptor appliance to pass-through destination TCP port 15000"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Configure in-path rules on the data center Steelhead appliances to pass-through the server IP addresses"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Configure a peering rule on the Interceptor appliance to pass-through destination TCP port 15000"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Configure a load-balancing rule on the Interceptor appliance to pass-through destination TCP port 15000"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Stop the Interceptor appliance service"
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
