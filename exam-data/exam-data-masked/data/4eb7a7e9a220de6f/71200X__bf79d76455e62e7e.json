    "Question #: 1": {
      "Title": "Exam 71200X topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have configured a TLS link between Avaya Aura\u00ae Communication Manager (CM) and Avaya Aura\u00ae Session Manager (SM). SM is using Identity certificates that have been signed by Avaya Aura\u00ae System Manager (SMGR) Certificate Authority (CA)."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which three tasks must be completed for the signaling link between CM and SM to come into service? (Choose three.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Export SM Identity certificate from SMGR and import it into CM using \"Security/Trusted Certificates\"."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Add the CA certificate to CM using \"Security/Trusted Certificates\" from the CM SMI screen."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Replace the CM default Server Identity Certificate with one generated by your Certificate Authority."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Download \"binary/to IE\" from SMGR."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Upload the CA certificate to CM using \"Miscellaneous/Download files\" from the CM SMI screen."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
