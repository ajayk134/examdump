        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The management interface (Meth0/0/0) cannot be used as a heartbeat interface."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The heartbeat interfaces of two firewalls can be added to different security zones."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. An interface configured with the vrrp virtual-mac enable command can be used as a heartbeat interface."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. An interface whose MTU value is less than 1500 can be used as a heartbeat interface."
