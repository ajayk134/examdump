          "content": [
            {
              "type": "text",
              "value": "B. Connect all computers in the office to UPS devices"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Re-map the mapped network drive with the domain administrator account"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Replace the hard drives on the file server hosting the shared files"
