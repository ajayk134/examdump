    "Question #: 7": {
      "Title": "Exam CA1-005 topic 1 question 8 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A company hired an email service provider called my-email.com to deliver company emails. The company started having several issues during the migration. A security engineer is troubleshooting and observes the following configuration snippet:"
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://img.examtopics.com/ca1-005/image2.png"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which of the following should the security engineer modify to fix the issue? (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The email CNAME record must be changed to a type A record pointing to 192.168.1.11"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The TXT record must be changed to \"v=dmarc ip4:192.168.1.10 include:my-email.com ~all\""
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The srv01 A record must be changed to a type CNAME record pointing to the email server"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The email CNAME record must be changed to a type A record pointing to 192.168.1.10"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The TXT record must be changed to \"v=dkim ip4:192.168.1.11 include :my-email.com ~all\""
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. The TXT record must be changed to \"v=spf ip4:192.168.1.10 include :my-email.com ~all\""
            }
          ]
        },
        "G": {
          "content": [
            {
              "type": "text",
              "value": "G. The srv01 A record must be changed to a type CNAME record pointing to the web01 server"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: DF \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
