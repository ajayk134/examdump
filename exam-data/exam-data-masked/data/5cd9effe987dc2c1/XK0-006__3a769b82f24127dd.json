          "content": [
            {
              "type": "text",
              "value": "A. cd /var/www/html/ && gzip -c /home/dev/web.bkp | tar xf -"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. pushd /var/www/html/ $$ cpio -idv < /home/dev/web.bkp && popd"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. tar -c -f /home/dev/web.bkp /var/www/html/"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. unzip -c /home/dev/web.bkp /var/www/html/"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
