    "Question #: 2": {
      "Title": "Exam ASVAB Test topic 1 question 10 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Alice leaves her house, driving east at 45 miles per hour (mph). Thirty minutes later, her husband Dave notices she forgot her cell phone and sets off after her."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "How fast must Dave travel in order to catch up with Alice 3 hours after he leaves?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. 49 mph"
            }
          ]
