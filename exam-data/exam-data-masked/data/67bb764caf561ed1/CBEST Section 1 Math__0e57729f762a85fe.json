          "content": [
            {
              "type": "text",
              "value": "B. The item costs $80."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. If the item had cost $20 more, she would have paid with cash."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The item costs at least $70."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The item costs more than $25."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: E \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Because Linda pays with a check only if an item costs more than $30, the item must have cost more than $25."
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "Because Linda pays with a check only if an item costs more than $30, the item must have cost more than $25."
          }
        ]
      },
