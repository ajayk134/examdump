      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Safe"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Care centered"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Efficient"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Effective"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
