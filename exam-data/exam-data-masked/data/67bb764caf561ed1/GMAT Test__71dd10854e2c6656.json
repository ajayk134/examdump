      "Question": {
        "content": [
          {
            "type": "text",
            "value": "If a, b, c and d are consecutive integers (a < b < c < d)."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What is the value of (d + c) \u05d2\u02c6\u2019 (b + a)?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. 1"
            }
