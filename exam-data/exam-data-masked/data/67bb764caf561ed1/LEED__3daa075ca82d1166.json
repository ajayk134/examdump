    "Question #: 9": {
      "Title": "Exam LEED topic 1 question 15 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "may contain what up to what percent recycled content?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. 5%"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. 25%"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. 90%"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. 100%"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Many steel products contain 90% or higher recycled content if manufactured by the electric arc furnace process. If the amount of recycled content is unknown, it can be assumed that 25% is postconsumer recycled."
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "Many steel products contain 90% or higher recycled content if manufactured by the electric arc furnace process. If the amount of recycled content is unknown, it can be assumed that 25% is postconsumer recycled."
          }
        ]
      },
