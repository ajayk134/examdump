    "Question #: 2": {
      "Title": "Exam NAPLEX topic 1 question 43 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "If you mix 30 gm 5% lidocaine cream and 90gm of 0.5% hydrocortisone cream, what percent of lidocaine and hydrocortisone do you have as the end product?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Lidocaine/Hydrocortisone 2%/1.25%"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Lidocaine/Hydrocortisone 0.375%/0.15%"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Lidocaine/Hydrocortisone 1.25 %/ 0.15%"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Lidocaine/Hydrocortisone 2% /0.25%"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Lidocaine/Hydrocortisone 1.25% /0.375%"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: E \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Lidocaine: 30g \u00c3\u2014 0.05 = 1.5g. Hydrocortisone: 90g \u00c3\u2014 0.005 = 0.45g. 90g + 30g = 120g. 1.5g/120g = 0.0125 \u00c3\u2014 100 = 1.25% Lidocaine. 0.45g/120g = 0.00375 \u00c3\u2014 100"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "= 0.375% Hydrocortisone."
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "Lidocaine: 30g \u00c3\u2014 0.05 = 1.5g. Hydrocortisone: 90g \u00c3\u2014 0.005 = 0.45g. 90g + 30g = 120g. 1.5g/120g = 0.0125 \u00c3\u2014 100 = 1.25% Lidocaine. 0.45g/120g = 0.00375 \u00c3\u2014 100"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "= 0.375% Hydrocortisone."
          }
        ]
      },
