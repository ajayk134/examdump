          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Users will be instructed to use the icon that best expresses their current experience using the application. This will allow the customer to collect valuable data about users."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which object type should be called from each page to implement this feature?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. An interface, because the component must render user interface elements."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. An expression rule, because the component captures expressions of user sentiment for analysis."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. A decision, because the component captures a choice that users select from an array of custom selection components, rather than a standard dropdown or radio button."
            }
          ]
        }
      },
      "Answer": {
        "content": []
