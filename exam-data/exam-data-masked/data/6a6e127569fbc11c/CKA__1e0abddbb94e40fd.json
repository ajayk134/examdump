          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Create a new ServiceAccount named cicd-token in the existing namespace app-team1."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Bind the new ClusterRole deployment-clusterrole to the new ServiceAccount cicd-token, limited to the namespace app-team1."
