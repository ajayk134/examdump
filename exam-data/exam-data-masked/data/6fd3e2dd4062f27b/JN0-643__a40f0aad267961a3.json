    "Question #: 2": {
      "Title": "Exam JN0-643 topic 1 question 9 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "R1 and R2 are ASBRs in the same area, each with an equal cost external path to the same external network prefix. R1 advertises an external route into OSPF with a Type 1 metric. R2 advertises an external route into OSPF with a Type 2 metric."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which route would be preferred?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. R1's route is preferred because Type 1 metrics take into account the external cost only."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. R1's route is preferred because Type 1 metrics take into account the internal and external cost."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. R2's route is preferred because Type 2 metrics take into account the internal and external cost."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. R2's route is preferred because Type 2 metrics take into account the external cost only."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
    "Question #: 3": {
      "Title": "Exam JN0-643 topic 1 question 15 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which statement is true about using an OSPF import policy?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Import policies are not allowed in OSPF, applying the policy will do nothing."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Applying an import policy to OSPF may block normal LSA flooding."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Import policies are allowed only for external route types."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Applying this policy will cause a commit failure."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
