      "Title": "Exam JN0-643 topic 1 question 6 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which CoS feature avoids congestion in a device by limiting traffic on ingress interfaces?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. rewrite rule"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. scheduler"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. drop profile"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. policer"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
