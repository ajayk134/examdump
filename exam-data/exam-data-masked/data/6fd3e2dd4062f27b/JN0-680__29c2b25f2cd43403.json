    "Question #: 8": {
      "Title": "Exam JN0-680 topic 1 question 58 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are configuring VXLAN on a network of QFX5100s, and are using the set vlans vlan100 vxlan unreachable-vtep-aging-timer 600 command."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What does this command do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. This command ages out a remotely learned VTEP address after 600 seconds of inactivity."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. This command ages out the address of the remote VTEP 600 seconds after the last learned MAC address expires."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. This command ages out all learned MAC addresses assigned to the VTEP after 600 seconds of inactivity."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. This command ages out a locally learned MAC address assigned to the VTEP after 600 seconds of inactivity."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "NOT A This answer is ambiguous and vague about which MACs are involved."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "B this answer is most detailed and accurate."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "C False; The aging timer refers to the remote VTEP MAC, not the MACs learned *via* that VTEP."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "D False; The aging timer refers to the remote VTEP MAC after MACs learned *via* that VTEP age out; not locally-learned MACs."
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "NOT A This answer is ambiguous and vague about which MACs are involved."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "B this answer is most detailed and accurate."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "C False; The aging timer refers to the remote VTEP MAC, not the MACs learned *via* that VTEP."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "D False; The aging timer refers to the remote VTEP MAC after MACs learned *via* that VTEP age out; not locally-learned MACs."
          }
        ]
      },
