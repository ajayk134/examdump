      "Title": "Exam GUARD topic 1 question 25 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A customer has a requirement to implement CyberArk with the lowest recovery time objective possible for the vault server failure in both the primary and secondary datacenter."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which Architecture is the most suitable for this?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Deploy a multi cloud, multi region Architecture with 4 vaults. 2 vaults per public cloud across different regions."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Deploy both Primary and DR vault clusters in primary and secondary datacenters."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Deploy Distributed vaults. 1 Primary vault and 1 satellite vault in the primary datacenter and 2 satellite vaults in the secondary datacenter."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Deploy Primary and DR standalone vaults in a single public cloud environment within the same region across different availability zones."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "B",
          "vote_count": 1,
