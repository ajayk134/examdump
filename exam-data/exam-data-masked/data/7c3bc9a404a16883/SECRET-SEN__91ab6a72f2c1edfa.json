    "Question #: 4": {
      "Title": "Exam SECRET-SEN topic 1 question 6 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An application is having authentication issues when trying to securely retrieve credential\u2019s from the Vault using the CCP webservices RESTAPI. CyberArk Support advised that further debugging should be enabled on the CCP server to output a trace file to review detailed logs to help isolate the problem."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What best describes how to enable debug for CCP?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Edit web.config. change the \u201cAIMWebServiceTrace\u201d value, restart Windows Web Server (IIS)"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. In the PVWA, go to the Applications tab, select the Application in question, go to Options > Logging and choose Debug."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. From the command line, run appprvmgr.exe update_config logging=debug."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Edit the basic_appprovider.conf, change the \u201cAIMWebServiceTrace\" value, and restart the provider."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "A",
          "vote_count": 1,
          "is_most_voted": true
        }
      ]
    },
