          "content": [
            {
              "type": "text",
              "value": "B. docker exec <ContainerName> evoke import \u2013 \u2013no-restart \u2013 \u2013root <rootCA.cer>"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. docker exec <ContainerName> evoke ca import \u2013 \u2013no-restart <rootCA.cer>"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. docker exec <ContainerName> ca import <rootCA.cer>"
