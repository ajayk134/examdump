      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Modify the script to use the CLI SDK to fetch the secret at runtime using Credential Providers installed on each workstation."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Modify the script to make a SOAP call to retrieve the secret from the Central Credential Provider."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Modify the script to run on WebSphere using the Application Server Credential Provider to retrieve the secret."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Use Conjur Summon to invoke the script and inject the secret at run time."
            }
          ]
        }
