    "Question #: 7": {
      "Title": "Exam SECRET-SEN topic 1 question 28 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have a PowerShell script that is being used on 1000 workstations. It requires a Windows Domain credential that is currently hard coded in the script."
