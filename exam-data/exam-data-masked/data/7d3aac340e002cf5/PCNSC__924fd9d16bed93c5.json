    "Question #: 5": {
      "Title": "Exam PCNSC topic 1 question 16 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A company has deployed an Active/Passive 5280 HA pair with BGP configured to the company\u2019s ISP. The lead firewall engineer has set the HA Timer to \u201cRecommended\u201d. Upon failing over the HA pair, there is a two-minute outage and internet traffic is dropped."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should the engineer do to eliminate or minimize the outage in the future?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Change the HA Timer to \u201cAggressive\u201d."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Enable Path Monitoring to the ISP."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Ensure that \u201cGraceful Restart\u201d has been enabled on all peers."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Change the HA Timer to \u201cAdvanced\u201d with \u201cPreemption Hold Time\u201d of one minute."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "C",
          "vote_count": 2,
          "is_most_voted": false
        }
      ]
    },
