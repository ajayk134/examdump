          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Reduce max.poll.records property."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Increase session.timeout.ms property."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Add more consumers instances."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Split consumers in different consumer groups."
            }
          ]
        }
