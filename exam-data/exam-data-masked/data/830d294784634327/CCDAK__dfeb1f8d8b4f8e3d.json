    "Question #: 3": {
      "Title": "Exam CCDAK topic 1 question 32 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Your application is consuming from a topic with one consumer group. The number of running consumers is equal to the number of partitions."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Application logs show that some consumers are leaving the consumer group during peak time, triggering a rebalance. You also notice that your application is processing many duplicates."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to stop consumers from leaving the consumer group."
