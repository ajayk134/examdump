    "Question #: 2": {
      "Title": "Exam CCDAK topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are designing a stream pipeline to monitor the real-time location of GPS trackers, where historical location data is not required."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Each event in the stream has the following structure:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "- Key: tracker_id"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "- Value: latitude, longitude"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to ensure that the latest location for each tracker is always retained in the Kafka topic."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which topic configuration parameter should you set?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. retention.ms = 0"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. min.cleanable.dirty.ratio = -1"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. cleanup.policy = compact"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. retention.ms = infinite"
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
