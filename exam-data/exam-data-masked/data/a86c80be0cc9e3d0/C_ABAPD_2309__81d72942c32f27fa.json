              "value": "C. A hashed table, when you read a subset in a loop and specify a part of the key from the left without gasp."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. A sorted table, when you read a single record and specify non-key fields."
