          "content": [
            {
              "type": "text",
              "value": "B. The field symbol can be reused for other programs."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The row content is copied to the field symbol instead to a work area."
            }
          ]
        },
        "D": {
          "content": [
