    "Question #: 4": {
      "Title": "Exam C1000-010 topic 1 question 20 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which statement applies when enforcing security on a project using Decision Center Business console?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Decision Center Enterprise console must be used to grant access permissions to custom groups."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Members of custom groups are restricted by the permissions assigned to that group, regardless of membership in other groups."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. When a user belongs to multiple groups and members of custom groups have varying permission levels, the most restrictive permissions apply."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. When a user belongs to multiple groups and members of custom groups have varying permission levels, the most restrictive permissions apply."
            }
          ]
        }
