        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. In the System Configuration section of the Admin, access the Asset Profile Configuration and reduce the retention values for the Asset Profiler Retention Configuration and Save. Next, deploy the changes into the environment for the updates to take effect."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. In the System Configuration section of the Admin, access the Asset Profile Configuration and increase the retention values for the Asset Profiler Retention Configuration and Save. Next, deploy the changes into the environment for the updates to take effect."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. On the navigation menu, click Admin, click the Asset Profile Configuration and reduce the retention values for the Asset Profiler Retention Configuration and Save. On the navigation menu, click Admin and from the Advanced menu, click Restart Event Collection Services. Next, deploy the changes into the environment for the updates to take effect."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. In the System Configuration section of the Admin, access the Asset Profile Configuration and increase the retention values for the Asset Profiler Retention Configuration and Save. On the navigation menu, click Admin and from the Advanced menu, click Restart Event Collection Services. Next, deploy the changes into the environment for the updates to take effect."
            }
          ]
        }
