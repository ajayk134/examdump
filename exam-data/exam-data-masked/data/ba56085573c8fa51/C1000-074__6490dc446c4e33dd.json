    "Question #: 1": {
      "Title": "Exam C1000-074 topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What happens if the GCD is not available upon startup of the Content Platform Engine?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The Content Platform Engine will use a cached in memory copy of the GCD and is fully functional."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The Content Platform Engine does not need the GCD, cached in memory or local file based copy."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The Content Platform Engine will use a local file based copy and can process requests that do not update the GCD."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The Content Platform Engine will use a local file based copy and is fully functional."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
