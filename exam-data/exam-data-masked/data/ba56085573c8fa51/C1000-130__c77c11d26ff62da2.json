      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What is the purpose of the Automation Assets Deployment capability?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. It is a streaming platform that enables organization and management of data from many different sources."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. It is a streaming platform that enables organization and management of data but only from a single source."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It allows the user to store, manage, retrieve, and search integration assets from within the Cloud Pak."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It allows the user to only store and manage integration assets from within the Cloud Pak."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
