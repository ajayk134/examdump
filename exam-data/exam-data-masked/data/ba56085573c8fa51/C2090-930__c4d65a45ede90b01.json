    "Question #: 1": {
      "Title": "Exam C2090-930 topic 1 question 2 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have two data sets. One data set contains customer name and age information along with a customer ID. The second data set contains the customer ID along with address information. There are no addresses which do not belong to a customer, there are customers which have no address, and there are customers which have multiple addresses."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which type of join will display all customers who have no recorded address?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Inner join"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Outer join"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Partial outer join"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Anti-join"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
