      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which action will temporarily disable remote login access using telnet and ssh for all non-root accounts?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Stop the sshd subsystem"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Set the PermitLogins parameter in /etc/ssh/sshd_config and recycle the sshd daemon"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Touch the /etc/sshd/nologin file and recycle the sshd daemon"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Update /etc/security/passwd and recycle the inetd subsystem"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Create an /etc/nologin file"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: E \ud83d\uddf3\ufe0f"
          }
        ]
      },
