      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An error intermediate event has been attached to a nested service to catch specific errors. How does the nested service define the error code thrown?"
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://www.examtopics.com/assets/media/exam-media/02049/0000700001.jpg"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. It is defined in an error end event."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. It is mapped to a variable in the nested service."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It is assigned programmatically to tw.error.code."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It is assigned programmatically to tw. nestedservice.error.code."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
