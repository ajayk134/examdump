              "type": "text",
              "value": "A. The worker nodes should be set to logging."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The control nodes must to be enabled with the external IP address configured."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The remote logging server must have at least 100 GB of storage."
            }
