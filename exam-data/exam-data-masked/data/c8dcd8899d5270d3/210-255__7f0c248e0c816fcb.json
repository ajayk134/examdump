    "Question #: 1": {
      "Title": "Exam 210-255 topic 1 question 4 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You see 100 HTTP GET and POST requests for various pages on one of your webservers. The user agent in the requests contain php code that, if executed, creates and writes to a new php file on the webserver. Which category does this event fall under as defined in the Diamond Model of Intrusion?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. delivery"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. reconnaissance"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. action on objectives"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. installation"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. exploitation"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
