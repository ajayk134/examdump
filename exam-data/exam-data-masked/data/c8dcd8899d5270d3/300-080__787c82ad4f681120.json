      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are deploy Cisco Unified Communications Manager Device Mobility in your environment, you note that phones in a remote site are failing to register. Which two actions correct the problem? (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Verify that the remote site is assigned to the device mobility group that matches its dialing pattern."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Verify that the phones are attempting to register with the correct mega cluster"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Verify that Extension Mobility is configured correctly for the remote site."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Verify that the LDAP server is configured to support Device Mobility at the remote site."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Verify that the subnet of the remote site is configured in Device Mobility Info."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: CE \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
