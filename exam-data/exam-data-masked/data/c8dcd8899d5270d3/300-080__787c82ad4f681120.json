      "Title": "Exam 300-080 topic 1 question 62 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "How does an IP Phone react upon initialization, if there is no CTL and ITL files present on the device?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The phone downloads only the files that are signed to that device."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The phone blindly trusts the next series of downloaded files."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The file matches the signature against the files on TFTP."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The phone displays the message, Unprovisioned."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
