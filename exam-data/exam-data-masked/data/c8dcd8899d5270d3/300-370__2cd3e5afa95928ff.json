    "Question #: 3": {
      "Title": "Exam 300-370 topic 1 question 24 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An AP will be deployed to an area where DHCP Option 43 is unavailable and the WLAN engineer is unable to have DNS modifications made to support this AP."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which two actions can enable the AP to join the WLC? (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. issue the clear capwap private-config command in the AP console."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Pre-stage or prime the AP on the same Layer 2 VLAN as the WLC."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Issue the capwap ap ip default-gateway WLC IP address command in the AP console."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Issue the capwap ap ip address WLC IP address command in the AP console."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Issue the capwap ap controller ip address WLC IP address command in the AP console."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AD \ud83d\uddf3\ufe0f"
          }
        ]
      },
