            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference: http://www.cisco.com/c/en/us/td/docs/wireless/controller/7-4/configuration/guides/consolidated/b_cg74_CONSOLIDATED/ b_cg74_CONSOLIDATED_chapter_0111110.html#ID4397"
