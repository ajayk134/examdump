    "Question #: 1": {
      "Title": "Exam 300-375 topic 1 question 11 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "After receiving an alert regarding a rogue AP, a network engineer logs into Cisco Prime and looks at the floor map where the AP that detected the rogue is located."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The map is synchronized with a mobility services engine that determines the rogue device is actually inside the campus. The engineer determines the rogue to be a security threat and decides to stop it from broadcasting inside the enterprise wireless network. What is the fastest way to disable the rogue?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Go to the location the rogue device is indicated to be and disable the power."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Create an SSID on the WLAN controller resembling the SSID of the rogue to spoof it and disable clients from connecting to it."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Classify the rogue as malicious in Cisco Prime."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Update the status of the rogue in Cisco Prime to contained."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Please refer to the step 10 of the topic \"Configuring Rouge Detection\" of the reference link."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference: http://www.cisco.com/c/en/us/td/docs/wireless/controller/7-4/configuration/guides/consolidated/b_cg74_CONSOLIDATED/ b_cg74_CONSOLIDATED_chapter_0111101.pdf"
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "Please refer to the step 10 of the topic \"Configuring Rouge Detection\" of the reference link."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference: http://www.cisco.com/c/en/us/td/docs/wireless/controller/7-4/configuration/guides/consolidated/b_cg74_CONSOLIDATED/ b_cg74_CONSOLIDATED_chapter_0111101.pdf"
          }
        ]
      },
      "Vote_count": [
        {
          "voted_answers": "A",
          "vote_count": 2,
          "is_most_voted": true
        }
      ]
    },
