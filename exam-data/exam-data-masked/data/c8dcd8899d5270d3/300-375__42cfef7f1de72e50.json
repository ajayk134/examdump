          },
          {
            "type": "text",
            "value": "A WLAN with the SSID Enterprise\" is configured. Which rogue is marked as malicious?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. a rogue with two clients, broadcasting the SSID \"Employee\" heard at -50 dBm"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. a rogue with no clients, broadcasting the SSID \"Enterprise\" heard at -50 dBm"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. a rouge with two clients, broadcasting the SSID \"Enterprise\" heard at -80 dBm"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. a rogue with two clients, broadcasting the SSID \"Enterprise\" heard at -50 dBm"
