    "Question #: 2": {
      "Title": "Exam 300-515 topic 1 question 4 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "image",
            "src": "https://www.examtopics.com/assets/media/exam-media/03555/0000300001.png"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Refer to the exhibit. A network engineer has been called to configure the four PE devices in order to enable full communication among the four CE devices connected to them. While starting to configure, he experienced a connectivity issue. Which two tasks should the engineer perform in order to begin the process correctly? (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Configure PE3 to export route-targets 100:1 and 200:2."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Configure PE3 to import route-targets 100:1 and 200:2."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Configure PE4 to import route-targets 101:1 and 202:2."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Configure PE2 to export route-targets 300:3 and 400:4."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Configure PE1 to import route-targets 300:3 and 400:4."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AB \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "AC",
          "vote_count": 1,
