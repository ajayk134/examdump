          "content": [
            {
              "type": "text",
              "value": "B. interface GigabitEthernet 0/10.10 encapsulation dot1q 10 rewrite ingress tag pop 1 symmetric l2vpn xconnect group 103588 p2p 103588 interface GigabitEthernet 0/10.10 neighbor ipv4 10.10.10.2 pw-id 103588"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. interface GigabitEthernet 0/10.10 l2transport encapsulation dot1q 10 l2vpn xconnect group 103588 p2p 103588 interface GigabitEthernet 2/10.10 neighbor ipv4 10.10.10.2 pw-id 103588"
