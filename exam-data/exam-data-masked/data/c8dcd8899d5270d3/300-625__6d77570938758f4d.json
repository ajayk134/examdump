    "Question #: 18": {
      "Title": "Exam 300-625 topic 1 question 50 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A storage administrator is upgrading Cisco NX-OS on a Cisco MDS switch. The administrator performs an ISSU upgrade following the configuration guide. While the install is proceeding, the administrator connects a new server to the switch, which cannot access storage. The existing servers continue to operate properly through the switch. Why is the new server failing to connect?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The fabric data plane resets as part of the upgrade process."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The new server is unable to log in to the fabric to receive an FC-ID."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The upgrade process disables any currently unused ports."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The zoning database is locked during the upgrade process."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
