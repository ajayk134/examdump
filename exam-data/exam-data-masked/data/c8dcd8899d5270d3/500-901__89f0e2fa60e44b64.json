            "value": "How do service profiles enable workload mobility?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Service Profiles represent a physical view of a server without any ties to specific virtual hardware"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Service Profiles work with the underlying hypervisor and communicate with the VM to detect workload movement"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Service Profiles represent a logical view of a server without any ties to specific physical hardware"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Service Profiles communicate workload movement to VCenter"
            }
          ]
        }
      },
      "Answer": {
        "content": [
