    "Question #: 10": {
      "Title": "Exam 642-883 topic 1 question 171 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Refer to the exhibit."
          },
          {
            "type": "break"
          },
