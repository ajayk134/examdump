          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Router B:router ospf 200 vrf AS 100-AS300redistribute bgp 200!router bgp 200vrf AS 100-AS300address-family ipv4 unicastredistribute ospf 200"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Router C:router ospf 200redistribute bgp 200!router bgp 200address-family ipv4redistribute ospf 200 subnet"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Router C:router ospf 200 vrf AS100-AS300redistribute bgp 200 subnets!router bgp 200vrf AS 100-AS300address-family ipv4unicastredistribute ospf 200"
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. Router C:router ospf 200 vrf AS100-AS300redistribute bgp 200 subnets!router bgp 200address-family ipv4 vrf AS 100-AS300redistribute ospf 200"
            }
          ]
        }
      },
      "Answer": {
