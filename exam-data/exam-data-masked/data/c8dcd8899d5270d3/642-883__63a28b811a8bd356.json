        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Router B:router ospf 200redistribute bgp 200 subnets!router bgp 200address-family ipv4 unicastredistribute ospf 200"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Router B:router ospf 200redistribute bgp 200 subnets!router bgp 200address-family ipv4 vrf AS 100-AS300redistribute ospf 200"
