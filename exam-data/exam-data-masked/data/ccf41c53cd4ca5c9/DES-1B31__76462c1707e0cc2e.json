          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Version 2 uses a namespace based signature Version 4 uses HMAC algorithm"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Version 2 uses the secret key to sign the request Version 4 uses a signing key"
            }
          ]
        }
