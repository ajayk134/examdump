    "Question #: 4": {
      "Title": "Exam E20-260 topic 1 question 67 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You created a synchronous consistency group, which contains two distributed volumes configured with the rule \"set cluster-1-detaches\"."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What is the expected behavior of the virtual volumes in the event of a WAN-COM failure?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. cluster-2 is declared the winner after 5 seconds and I/O will continue at that cluster."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. I/O will continue at both clusters."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. I/O will be suspended at both clusters until the WAN-COM is repaired."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. cluster-1 is declared the winner after 5 seconds and I/O will continue at that cluster."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
