        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Snapshot deltas will be stored in SRP_2."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Snapshot deltas will be stored in SRP_1."
            }
          ]
        }
