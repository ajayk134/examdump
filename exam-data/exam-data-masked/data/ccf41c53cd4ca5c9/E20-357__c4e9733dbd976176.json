    "Question #: 2": {
      "Title": "Exam E20-357 topic 1 question 117 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What is the recommended method when cabling an Isilon cluster with dual InfiniBand switches?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. All int-a InfiniBand switch ports should be connected to one switch and all int-b ports should be cabled to the second switch."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. All internal switch ports on odd-numbered nodes should be attached to switch one and all even-numbered nodes should be cabled to switch two."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. All int-a switch ports should be cabled to the top row of switch ports on switch one and all int-b ports should be cabled to the bottom row of ports of switch one. Once switch one is full, continue cabling on switch two."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It does not matter which switch ports are used. Any internal switch port can be cabled to either of the InfiniBand switches."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
