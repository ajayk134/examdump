    "Question #: 1": {
      "Title": "Exam E20-357 topic 1 question 13 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A storage administrator used the shutdown -p <time> command to bring down an EMC Isilon cluster. What could be the result of this action?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Data can become corrupted on the filesystem"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The filesystem could be left mounted when all nodes have shut down"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The NVRAM will be flushed"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Confirmation must first be acknowledged before actual shutdown"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
