          "content": [
            {
              "type": "text",
              "value": "C. SAV Pool"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Reserved LUN Pool"
            }
          ]
        }
      },
      "Answer": {
        "content": [
