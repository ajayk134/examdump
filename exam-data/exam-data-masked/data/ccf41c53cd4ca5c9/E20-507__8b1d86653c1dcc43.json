    "Question #: 3": {
      "Title": "Exam E20-507 topic 1 question 15 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "The Reserved Capacity for a Storage Resource Pool (SRP) on a VMAX3 has been set to 15%. A TimeFinder SnapVX snapshot has been created for a Storage"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Group containing 10 devices. An application is actively performing read and write I/Os to these devices. The snapshot is linked to the target in Copy mode."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Allocation for the SRP reaches 85%."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What will happen to the copy process?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Copy to target will halt"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Copy to target will fail"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Tracks required for the copy will be allocated from the Reserved Capacity"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Copy to target will continue and complete"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
