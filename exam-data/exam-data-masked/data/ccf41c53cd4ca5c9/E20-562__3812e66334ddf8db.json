    "Question #: 20": {
      "Title": "Exam E20-562 topic 1 question 61 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "In preparing a host to access its storage from VPLEX, what is considered a best practice when zoning?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Ports on host HBA should be zoned to either an A director or a B director."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Each host should have at least one path to an A director and at least one path to a B director on each fabric, for a total of four logical paths."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Dual fabrics should be merged into a single fabric to ensure all zones are in a single zoneset."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Each host should have either one path to an A director or one path to a B director on each fabric, for a minimum of two logical paths."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
