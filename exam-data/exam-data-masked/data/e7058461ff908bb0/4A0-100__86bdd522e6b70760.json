    "Question #: 16": {
      "Title": "Exam 4A0-100 topic 2 question 138 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Router R3 receives an LSA with the sequence number 111 from router R4 and then receives another copy of the LSA with a sequence number 112 from router R2. What does router R3 do with the LSA from R2?"
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://img.examtopics.com/4a0-100/image4.png"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. R3 discards the LSA received from R2 and sends a copy of the LSA from its link state base to R2."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. R3 installs the LSA received from R2 in its link state database and floods a copy to its neighbors."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. R3 discards the LSA received from R2 and sends an ACK to R2."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. R3 installs the LSA received from R2 in its link state database, sends an ACK to R2, and floods a copy to its neighbors."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "D",
          "vote_count": 1,
