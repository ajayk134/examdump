          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It will send a PIM (*, G) prune to the RP and a PIM (S, G) prune to the source"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It will issue an IGMP Group Specific Query"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. It will issue an IGMP General Query"
            }
          ]
