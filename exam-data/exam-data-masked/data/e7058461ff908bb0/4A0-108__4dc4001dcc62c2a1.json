      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Both Router B and Router C will propagate a PIM (*, G) Join to the RP when a receiver joins"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Only Router B will propagate a PIM (*.G) Join to the RP when a receiver joins"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Only Router C will propagate a PIM(\\G) Join to the RP when a receiver joins"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Depends on the next hop for RP in Router D's RPF table"
