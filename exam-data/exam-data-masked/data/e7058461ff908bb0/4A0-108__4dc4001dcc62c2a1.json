        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The ingress PE sends a MP_REACH_NLRI message to activate the Intra-AS I-PMSI A-D route."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The ingress PE sends a MPJJNREACH_NLRI message to withdraw the S-PMSI A-D route."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The ingress PE stops sending the S-PMSI A-D route."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The ingress PE stops sending the Source Active A-D route."
            }
          ]
        }
      },
      "Answer": {
