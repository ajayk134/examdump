          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. IMMEDIATE"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. ABORT"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. NORMAL"
            }
          ]
