      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What are the recommendations for Oracle Database 11g installation to make it Optimal Flexible Architecture (OFA)-compliant? (Choose all that apply.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. ORACLE_BASE should be set explicitly."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. An Oracle base should have only one Oracle home created in it."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Flash recovery area and data file location should be on separate disks."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Flash recovery area and data file location should be created under Oracle base in a non-Automatic Storage Management (ASM) setup."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: ACD \ud83d\uddf3\ufe0f"
          }
        ]
      },
