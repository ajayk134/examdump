    "Question #: 3": {
      "Title": "Exam 1z0-053 topic 9 question 6 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "In what state are the datafiles of a tablespace after a TSPITR has been successfully completed?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The datafiles have an ONLINE status."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The datafiles have an OFFLINE status."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The datafiles have an ONLINE status and are in hot backup mode prepared for an online backup."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The datafiles have an OFFLINE status and are in hot backup mode for an online backup."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The datafiles are in STANDBY mode."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
