    "Question #: 2": {
      "Title": "Exam 1z0-076 topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which three are prerequisites for enabling Fast-Start Failover? (Choose three.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The configuration must be operating in either Maximum Performance or Maximum Availability mode."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Flashback Database must be enabled on both the primary database and the Fast-Start Failover target standby database."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The maximum protection mode can be used, but with two or more standby databases."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The Data Guard environment must be managed by the Data Guard Broker."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The Fast-Start Failover target standby database must receive REDO directly from the primary database."
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. You can specify only one standby database as the fast-start failover target."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: ABD \ud83d\uddf3\ufe0f"
          }
        ]
      },
