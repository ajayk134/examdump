    "Question #: 1": {
      "Title": "Exam 1z0-105 topic 1 question 2 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Examine this extract from /etc/httpd/conf/httpd.conf for virtual hosts:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "<VirtualHost *:80>"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ServerAdmin [email protected]"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "DocumentRoot /www/docs/site1.example.com"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ServerName site1.example.com -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "</VirtualHost>"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "<VirtualHost *:80>"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ServerAdmin [email protected]"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "DocumentRoot /www/docs/site2.example.com"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ServerName site2.example.com -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "</VirtualHost>"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which three statements are true about the configuration extract?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. To connect to the website, site1.example.com must resolve to a different IP address than site2.example.com."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. site1.example.com and site2.example.com can share the same IP address."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The web server attempts a DHCP discover to assign one IP address per virtual host."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It is possible but not mandatory to have unique IP addresses for each virtual host."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The site1.example.com virtual host shares and error logs with site2.example.com."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: ACE \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
    "Question #: 2": {
      "Title": "Exam 1z0-105 topic 1 question 15 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Examine the virt-install command."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "# virt-install \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "--connect qemu:///system \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "--virt-type kvm \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "-- name test \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "-- ram 500 \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "--disk path =/var/lib/libvirt/images/test.img, size=4"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "--cdrom /home/user01/DownLoads/OracleLinux-R6-U5-Server-x86_64-dvd.iso \\"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "--os-variant oe16"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which two statements are true?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The --connect option specifies the credentials for the hypervisor to use."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The --name option specifies the name of the new guest virtual machine instance."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The --ram option specifies the memory to allocate for a guest instance in MB."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The --virtype option specifies that only the keyboard, video, and mouse are fully virtualized."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The --disk option specifies the media to use as storage for the guest. The size of the storage will be 4 GB."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AB \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    }
  }
