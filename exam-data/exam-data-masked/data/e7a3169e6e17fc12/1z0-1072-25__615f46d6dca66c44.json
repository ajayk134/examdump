    "Question #: 5": {
      "Title": "Exam 1z0-1072-25 topic 1 question 25 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "In an Object Storage bucket you have two objects named ObjectA and ObjectB. ObjectA was last modified six months ago and ObjectB was modified 14 months ago. You create a retention rule and specify a duration of 1 year."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What does the rule do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. It prevents the modification or deletion of ObjectA for the next 6 months and prevents the modification or deletion of ObjectB for the next 2 months."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. It prevents the modification or deletion of ObjectA and Object for the next 12 months."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. It prevents the modification or deletion of ObjectA for the next 12 months and prevents the modification or deletion of ObjectB for the next 14 months."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. It prevents the modification or deletion of ObjectA for the next 6 months and allows the modification or deletion of ObjectB."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
