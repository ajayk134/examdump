    "Question #: 5": {
      "Title": "Exam 1z0-146 topic 1 question 73 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Examine the commands:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "CREATE TYPE typ_course_tab IS VARRAY(5) OF VARCHAR2(20) /"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "CREATE TYPE typ_course_nst AS TABLE OF typ_course_tab /"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "CREATE TABLE faculty (faculty_id NUMBER(5), faculty_name VARCHAR2(30), courses typ_course_nst) NESTED TABLE courses STORE AS course_stor_tab /"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "INSERT INTO faculty VALUES (101, 'Jones', NULL);"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "UPDATE (SELECT courses FROM faculty WHERE faculty_id=101) SET courses = typ_course_nst(11,'Oracle');"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which statement is true about the execution of these commands?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. All the commands execute successfully."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Only the first two commands execute successfully."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Only the first four commands execute successfully."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Only the first three commands execute successfully."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
