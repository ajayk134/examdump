      "Title": "Exam 1z0-146 topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which two statements are true about the inlining of PL/SQL subprograms? (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Only local subroutines can be inlined"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Inlining always reduces the execution time of a PL/SQL program unit"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. PLSQL_OPTIMIZE_LEVEL must be set to a value greater than or equal to 2"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The PL/SQL programs that make use of relatively large helper subroutines are good candidates for inlining"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AC \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "AC",
          "vote_count": 1,
          "is_most_voted": true
        }
      ]
