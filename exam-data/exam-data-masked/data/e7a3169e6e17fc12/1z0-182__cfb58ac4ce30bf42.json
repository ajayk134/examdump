      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which of the following ALTER SYSTEM statements can be run from within a pluggable database (PDB) and affect the entire container database (CDB)?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. ALTER SYSTEM ENABLE / DISABLE RESTRICTED SESSION"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. ALTER SYSTEM FLUSH BUFFER_CACHE"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. ALTER SYSTEM CHECKPOINT"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. ALTER SYSTEM SWITCH LOGFILE"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: BC \ud83d\uddf3\ufe0f"
          }
        ]
      },
