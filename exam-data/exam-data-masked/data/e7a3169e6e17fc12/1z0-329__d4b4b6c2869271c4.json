    "Question #: 1": {
      "Title": "Exam 1z0-329 topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are part of a new implementation and have the seeded HR Specialist role. You are able to find all the workers in Person Gallery, but not able to view a single worker on the Person Management page. Identify two reasons for this. (Choose two.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The Person Security Profile in the data role, which is attached to the seeded HR Specialist application role, does not allow the person access to data."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The Refresh Manager Hierarchy process is not run in the instance."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The Public Person Security Profile is set up as View All People in the data role, which is attached to the seeded HR Specialist application role."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The seeded HR Specialist role does not have access to hire the worker in the instance."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. The Person Profile is not created for any of the employees in the new instance."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AD \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "AD",
          "vote_count": 1,
          "is_most_voted": true
        }
      ]
    },
