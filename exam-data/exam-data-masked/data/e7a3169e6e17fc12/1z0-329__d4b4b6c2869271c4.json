    "Question #: 4": {
      "Title": "Exam 1z0-329 topic 1 question 15 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A human resource specialist creates a checklist template with Category Offboarding and Action Termination. An employee retires from the organization and hence his work relationship is terminated with the legal employer. However, there is no Offboarding checklist allocated to the retired employee in the Manage Allocated"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Checklist region."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What is the cause for this?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Action Type was not defined for the checklist."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The Action associated with the checklist does not match the Action selected during the termination process."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Action Reasons were not defined in the checklist."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The Allocate Checklist seeded process must be run to automatically allocate the checklist to the person."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
