    "Question #: 1": {
      "Title": "Exam 1z0-432 topic 1 question 7 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "The DISK_REPAIR_TIME attribute has expired after a transient disk error. What happens next?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Nothing, it was only a warning. All the disks are OK"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. This means that the disk is repaired and is put back in the ASM disk group."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Oracle ASM drops the disk."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. This means that Oracle will use ASM Fast Mirror Resync to sync the rest of the disks."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
