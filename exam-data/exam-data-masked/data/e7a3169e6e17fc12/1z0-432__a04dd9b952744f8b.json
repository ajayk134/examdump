    "Question #: 4": {
      "Title": "Exam 1z0-432 topic 1 question 66 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are given the task of managing an Oracle RAC 12cR1 Cluster by using Oracle Flex ASM. Which two statements are valid?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. A failure of an ASM instance affects the databases, even if you are using ASM disk groups"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. A failure of an ASM instance affects availability for the databases using ASM disk groups due to decreased cardinality of available ASM instances"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. To determine whether Oracle Flex ASM is enabled, use asmcmd show cluster mode"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. When deployed, Oracle Flex ASM enables an Oracle ASM instance to run on a separate physical server from the database server"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AD \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
