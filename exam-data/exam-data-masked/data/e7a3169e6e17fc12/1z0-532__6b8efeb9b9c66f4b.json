              "type": "text",
              "value": "A. Select Document > Reporting > Security > Security report."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Select Tasks > Extract Tasks > Extract Security."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Select Tasks > Extract Tasks > Extract Metadata."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. In the EPMA Dimension Library, under the Security Class dimension for the application, right-click the application and select Assign Access Control, then select Security reports, and choose Classes by user."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. In Shared Services, right-click the application and select Assign Access control, then select Security reports, and choose Classes by user."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
