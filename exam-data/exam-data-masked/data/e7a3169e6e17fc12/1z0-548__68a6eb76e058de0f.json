    "Question #: 2": {
      "Title": "Exam 1z0-548 topic 1 question 21 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "For XYZ Company, the Costing Allocation Flexfield structure has three segments: Company, Cost Center, and Account. One of the employees was initially costed to the 3500 cost center and his accounting entries for a non-recurring earning element were as follows:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Debit: 100. 3500.6000, Credit: 105. 1000.7000"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The cost center was changed to 5000 and the RetroCosting Process was run. What will be the costing entries created by the retro costing process?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Debit: 100.5000.6000, Credit: 100.3500.6000"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Debit: 100.5000.6000, Credit: 105.1000.7000"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Debit: 100.3500.6000, Credit: 100.5000.6000"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Debit: 100.3500.6000, Credit: 105.1000.7000"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. No entries will be created because the costing process has already been run for the assignment."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
