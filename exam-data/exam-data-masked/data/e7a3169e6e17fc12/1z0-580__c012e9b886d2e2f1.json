    "Question #: 3": {
      "Title": "Exam 1z0-580 topic 1 question 14 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "What two features identify Oracle Solaris 11 as being \"built for clouds\"?"
