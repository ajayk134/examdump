    "Question #: 8": {
      "Title": "Exam 1z0-883 topic 1 question 37 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are using CTIDS in replication. You need to skip a transaction with the CTID of aaa-bbb-ccc-ddd-eee : 3 on a slave."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which command would you execute from a Mysql prompt?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. STOP SLAVE; SETGTID_NEXT=\"aaa-bbb-ccc-ddd-eee: 3\"; BEGIN; COMMIT; SET GTID_NEXT=\"AUTOMATIC\"; START SLAVE"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. STOP SLAVE; SET GLOBAL SQL_SLAVE_SKIP_COUNTER=1; START SLAVE;"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. STOP SLAVE; BEGIN; SET GTID_IGNORE=\"aaa-bbb-ccc-ddd-eee: 3\"; COMMIT; START SLAVE;"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. STOP SLAVE; RESET SLAVE; BEGIN; SKIP NEXT GTID; COMMIT; START SLAVE;"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "http://blog.secaserver.com/2011/11/resync-mysql-masterslave-replication/"
          }
        ]
      },
      "Explanation": {
