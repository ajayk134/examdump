          "content": [
            {
              "type": "text",
              "value": "A. Disabling connections from named pipes or socket files (depending on the operating system of the server)"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Running the server with \u2013 skip-networking specified"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Limiting logins to originate from the application server or the server\u2019s subnet"
