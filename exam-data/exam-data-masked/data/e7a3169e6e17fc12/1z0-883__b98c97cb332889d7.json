  "1z0-883__b98c97cb332889d7": {
    "Question #: 1": {
      "Title": "Exam 1z0-883 topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A simple master-to-slave replication is currently being used. The following information is extracted from the SHOW SLAVE STATUS output:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Last_SQL_Error: Error 'Duplicate entry '8' for key 'PRIMARY' ' on query. Default database: 'mydb'. Query: 'insert into mytable VALUES ('8' , 'George') '"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Skip_Counter: 0 -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Retrieved _Gtid_Set: 38f32e23480a7-32a1-c323f78067fd37821: 1-8"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Auto _Position: 1 -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You execute a \"SHOW CREATE TABLE mytable\" on the slave:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "CREATE TABLE mytable ("
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ID int(11) NOT NULL DEFAULT 0,"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "name char(10) DEFAULT NULL,"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "PRIMARY KEY (ID)"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": ")"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The table mytable on the slave contains the following:"
          },
          {
            "type": "break"
          },
          {
            "type": "image",
            "src": "https://www.examtopics.com/assets/media/exam-media/02339/0000200001.png"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You have issued a STOP SLAVE command. One or more statements are required before you can issue a START SLAVE command to resolve the duplicate key error."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which statement should be used?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. SET GLOBAL SQL_SKIP_SLAVE_COUNTER=1"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. SET GTID_NEXT=\"CONSISTENCY\"; BEGIN; COMMIT; SET GTID_NEXT=\" AUTOMATIC\u2019;"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. SET GLOBAL enforce_gtid_consistency=ON"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. SET GTID_EXECUTED=\"38f32e23480a7-32a1-c323f78067fd37821 : 9\";"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. SET GTID_NEXT=\"38f32e23480a7-32a1-c323f78067fd37821 : 9\"; BEGIN; COMMIT; SET GTID_NEXT=\"AUTOMATIC\";"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
