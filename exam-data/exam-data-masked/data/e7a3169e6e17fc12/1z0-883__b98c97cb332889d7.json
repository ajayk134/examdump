    "Question #: 3": {
      "Title": "Exam 1z0-883 topic 1 question 17 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Assume that you want to know which Mysql Server options were set to custom values."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which two methods would you use to find out?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Check the configuration files in the order in which they are read by the Mysql Server and compare them with default values."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Check the command-line options provided for the Mysql Server and compare them with default values."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Check the output of SHOW GLOBAL VARIABLES and compare it with default values."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Query the INFORMATION_SCHEMA.GLOBAL_VARIABLES table and compare the result with default values."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: CD \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
