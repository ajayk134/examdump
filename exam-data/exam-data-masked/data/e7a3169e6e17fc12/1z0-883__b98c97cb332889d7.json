    "Question #: 4": {
      "Title": "Exam 1z0-883 topic 1 question 18 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You install a copy of Mysql 5.6.13 on a brand new Linux server by using RPM packages. The server starts successfully as verified by the following commands:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "$ pidof mysqld"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "3132"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "$tail - n2 /var/lib.mysql/hostname.err"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "2013-08-18 08:18:38 3132 [Note] /usr/sbin/mysqld: ready for connections."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Version: 5.6.13-enterprise-commercial-advaced socket: /tmp/mysql.sock port;"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "3306 Mysql Enterprise Server Advanced Edition (Commercial)"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You attempt to log in as the root user with the following command:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "$mysql u root"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ERROR 1045 (28000): Access denied for user root@localhost (using password: NO)"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which statement is true about this scenario?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The RPM installation script sets a default password of password for new installations."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The local root user must log in with a blank password initially: mysql \u2013u root \u2013p."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. New security measures mean that the mysql_secure_installation script must be run first on all new installations."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The mysql_install_bd post-installation script used \u2013 random-password."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: B \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
    "Question #: 5": {
      "Title": "Exam 1z0-883 topic 1 question 19 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A Mysql Server has been running an existing application successfully for six months."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The my.cnf is adjusted to contain the following additional configuration:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "[mysqld]"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Default-authentication-plugin=sha256_password"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The Mysql Server is restarted without error."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What effect will the new configuration have in existing accounts?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. They will have their passwords updated on start-up to sha256_password format."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. They will have to change their password the next time they login to the server."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. They are not affected by this configuration change."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. They all connect via the secure sha256_password algorithm without any configuration change."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "http://dev.mysql.com/doc/refman/5.6/en/sha256-authentication-plugin.html"
          }
        ]
      },
