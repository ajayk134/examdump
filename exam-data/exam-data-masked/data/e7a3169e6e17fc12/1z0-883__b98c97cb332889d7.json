    "Question #: 6": {
      "Title": "Exam 1z0-883 topic 1 question 33 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "The InnoDB engine has a feature known as clustered indexes."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which three statements are true about clustered indexes as used in InnoDB?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. A primary key must exist for creation of a clustered index."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. A primary key is used as a clustered index."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. A clustered index is a grouping of indexes from different tables into a global index for faster searching."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. If no indexes exist, a hidden clustered index is generated based on row IDs."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. A clustered index provides direct access to a page containing row data."
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. The first unique index is always used as a clustered index and not a primary key."
            }
          ]
        },
        "G": {
          "content": [
            {
              "type": "text",
              "value": "G. A clustered index allows fulltext searching within InnoDB,"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: BDG \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Reference:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "http://dev.mysql.com/doc/refman/5.0/en/innodb-index-types.html"
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "Reference:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "http://dev.mysql.com/doc/refman/5.0/en/innodb-index-types.html"
          }
        ]
      },
