    "Question #: 4": {
      "Title": "Exam 1z0-888 topic 1 question 10 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Which three are key advantages of standard MySQL replication? (Choose three.)"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. supports native automatic failover"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. enables automatic resync of databases when discrepancies are detected"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. provides arbitrary geographic redundancy with minimal overhead to master"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. synchronously guarantees identical slave copy"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. is easy to configure and has low performance overhead"
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. can easily add slaves for read scaling"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: BEF \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
