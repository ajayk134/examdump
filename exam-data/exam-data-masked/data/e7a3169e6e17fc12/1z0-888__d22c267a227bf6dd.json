              "type": "text",
              "value": "A. The access does not take effect until the user logs out and back in."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. The access does not take effect until the next time the server is started."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. The access is available immediately."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. The access does not take effect until you issue the FLUSH PRIVILEGES statement."
