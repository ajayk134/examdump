    "Question #: 1": {
      "Title": "Exam CPIM topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "How would a master production schedule (MPS) be used in an assemble-to-order (ATO) manufacturing environment?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. The MPS is used to plan subassemblies and components; end items are only scheduled when a customer order is received."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Subassemblies are scheduled in the MPS when the customer order is received, and production can start."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Typically, the MPS is not used in companies using an ATO manufacturing strategy."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Often in an ATO environment, the MPS is created once a year and only revised if a product is discontinued."
            }
          ]
        }
      },
      "Answer": {
        "content": []
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": [
        {
          "voted_answers": "B",
          "vote_count": 1,
          "is_most_voted": false
        }
      ]
    },
