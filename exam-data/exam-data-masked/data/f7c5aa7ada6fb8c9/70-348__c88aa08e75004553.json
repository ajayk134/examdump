              "value": "B. Select the Master Program field as the value for filtering."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Select the Subprojects check box."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Select the Project Details view."
            }
          ]
        }
      },
      "Answer": {
        "content": [
