    "Question #: 2": {
      "Title": "Exam 70-348 topic 1 question 3 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You are the Microsoft PPM administrator for a large company. The IT manager uses four business drivers for prioritization. The priority of all four drivers is set at"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "25 percent."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The IT manager adds an additional business driver that has a priority value set to 30 percent."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to create a new prioritization that includes the additional business driver."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Create a new calculated prioritization. Select the drivers to prioritize."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Create a new manual prioritization. Select the correct department, and then select the drivers to prioritize."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Create a new manual prioritization. Select the drivers to prioritize, enter the value for each driver, and then choose to normalize."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Create a new manual prioritization. Select the drivers to prioritize, and then rank the drivers sequentially."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
