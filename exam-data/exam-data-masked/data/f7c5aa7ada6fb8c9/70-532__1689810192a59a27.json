      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have a website that is hosted on Azure. You connect to the site by using the URI http://www.contoso.com. You plan to publish a new version of the website."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to acquire the publishing profile for the website."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which two actions will achieve the goal? Each correct answer presents a complete solution."
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Run the following Windows PowerShell cmdlet:Get-AzurePublishSettingsFile"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Run the following Windows PowerShell cmdlet:Get-AzureSubscription"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Navigate to the following URI: https://www.contoso.com/download/publishprofile.aspx"
