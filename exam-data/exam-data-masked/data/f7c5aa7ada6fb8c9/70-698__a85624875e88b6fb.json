    "Question #: 1": {
      "Title": "Exam 70-698 topic 1 question 23 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Note: This question is part of a series of questions that use the same set of answer choices. Each answer choice may be used once, more than once, or not at all."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Your network contains a single Active Directory domain. The domain contains a VPN server that supports all of the VPN protocols."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "From a computer that runs Windows 10 Pro, a user named User1 creates an SSTP VPN connection to a network named VPN1."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "User1 successfully connects to the VPN server. When User1 roams between different Wi-Fi access points, the user loses the connection to the corporate network and must manually re-establish the VPN connection."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to ensure that VPN1 automatically maintains the connection while the user roams between Wi-Fi access points."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Click Turn on password protected sharing."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Disable Network Discovery."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Modify the Profile settings of an incoming firewall rule."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Run the Add-VpnConnectionTriggerApplication cmdlet."
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. Run the New-NetFirewallRule cmdlet and specify the- Direction Outbound parameter."
            }
          ]
        },
        "F": {
          "content": [
            {
              "type": "text",
              "value": "F. Run the New-VpnConnection cmdlet."
            }
          ]
        },
        "G": {
          "content": [
            {
              "type": "text",
              "value": "G. Run the Set-NetConnectionProfile cmdlet."
            }
          ]
        },
        "H": {
          "content": [
            {
              "type": "text",
              "value": "H. Run the Set-VPNConnection cmdlet."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "https://technet.microsoft.com/en-us/library/dn296460(v=wps.630).aspx"
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "https://technet.microsoft.com/en-us/library/dn296460(v=wps.630).aspx"
          }
