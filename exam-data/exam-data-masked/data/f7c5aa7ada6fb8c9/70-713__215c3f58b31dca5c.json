      "Question": {
        "content": [
          {
            "type": "text",
            "value": "An organization is implementing a SAM program. The organization is focused on achieving Tier 1 of the ISO 19770-1 specification."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to verify that contracts are reported on and inventoried."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you include in the report?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. the last reported hardware inventory date"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. any approved exceptions to the contracts"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. contracts that do not match billing statements"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. the last reported software inventory date"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: D \ud83d\uddf3\ufe0f"
          }
        ]
