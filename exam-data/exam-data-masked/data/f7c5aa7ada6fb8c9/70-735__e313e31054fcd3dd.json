    "Question #: 1": {
      "Title": "Exam 70-735 topic 1 question 1 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "Note: This question is part of a series of questions that present the same scenario. Each question in the series contains a unique solution that might meet the stated goals. Some question sets might have more than one correct solution, while others might not have a correct solution."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "After you answer a question in this sections, you will NOT be able to return to it. As a result, these questions will not appear in the review screen."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You are building a new image of Windows 10 that contains a push-button reset solution."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to test whether push-button reset works as expected."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Solution: From Windows 10, you press and hold the SHIFT key, and then you restart the computer. After the computer restarts, you click Troubleshoot, and then you click Reset this PC."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Does this meet the goal?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Yes"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. No"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "References:"
          },
          {
            "type": "break"
          },
