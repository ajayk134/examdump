            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. %WINDIR%\\Panther\\"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. %WINDIR%\\System32\\Sysprep\\Panther"
            }
          ]
        }
      },
      "Answer": {
        "content": [
