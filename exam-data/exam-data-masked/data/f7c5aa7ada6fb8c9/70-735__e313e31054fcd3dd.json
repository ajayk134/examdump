    "Question #: 5": {
      "Title": "Exam 70-735 topic 1 question 45 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have an image of Windows 10."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You obtain a feature update for Windows 10."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to include the feature update in the image. The solution must minimize the size of the image."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Mount the image. Run dism.exe /Add-Package, and then run dism.exe /Optimize-Image. Unmount the image."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Deploy the image to a computer. Install the feature update. Optimize the drive, and then capture the image."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Download the new installation media for Windows 10. Install Windows 10 on a computer, and then capture the image."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Mount the image. Run dism.exe /Add-Package, and then run dism.exe /Cleanup-Wim. Unmount the image."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: C \ud83d\uddf3\ufe0f"
          }
        ]
      },
      "Explanation": {
        "content": []
      },
      "Vote_count": []
    },
    "Question #: 6": {
