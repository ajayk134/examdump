    "Question #: 2": {
      "Title": "Exam 70-735 topic 1 question 18 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You have a computer that runs Windows 10. The computer starts in UEFI mode and has a 64-bit processor."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You insert a USB key in the computer. The USB key has a drive letter of F."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to ensure that you can start the computer by using Windows Preinstallation Environment (Windows PE) from the USB key."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Which two commands should you run? Each correct answer presents part of the solution."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "NOTE: Each correct selection is worth one point."
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. makewinpemedia.cmd /UFD C:\\WinPe F:"
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. makewinpemedia.cmd /ISO C:\\WinPe F:"
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. copype.cmd amd64 C:\\WinPe"
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. dism.exe /Export-Image /SourceImageFile:C:\\WinPE\\boot.wim/SourceIndex:1/DestinationImageFile:F:\\boot.wim"
            }
          ]
        },
        "E": {
          "content": [
            {
              "type": "text",
              "value": "E. copype.cmd x86 C:\\WinPe"
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: AE \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "References:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "https://docs.microsoft.com/en-us/windows-hardware/manufacture/desktop/winpe-create-usb-bootable-drive"
          }
        ]
      },
      "Explanation": {
        "content": [
