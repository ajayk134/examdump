    "Question #: 3": {
      "Title": "Exam AZ-200 topic 2 question 5 discussion - ExamTopics",
      "Question": {
        "content": [
          {
            "type": "text",
            "value": "You develop an app that allows users to upload photos and videos to Azure storage. The app uses a storage REST API call to upload the media to a blob storage account named Account1. You have blob storage containers named Container1 and Container2."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Uploading of videos occurs on an irregular basis."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "You need to copy specific blobs from Container1 to Container2 in real time when specific requirements are met, excluding backup blob copies."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "What should you do?"
          }
        ]
      },
      "Choices": {
        "A": {
          "content": [
            {
              "type": "text",
              "value": "A. Run the Azure PowerShell command Start-AzureStorageBlobCopy."
            }
          ]
        },
        "B": {
          "content": [
            {
              "type": "text",
              "value": "B. Use AzCopy with the Snapshot switch to copy blobs to Container2."
            }
          ]
        },
        "C": {
          "content": [
            {
              "type": "text",
              "value": "C. Copy Blobs to Container2 by using the Put Blob operation of the Blob Service REST API."
            }
          ]
        },
        "D": {
          "content": [
            {
              "type": "text",
              "value": "D. Download the blob to a virtual machine and then upload the blob to Container2."
            }
          ]
        }
      },
      "Answer": {
        "content": [
          {
            "type": "text",
            "value": "Suggested Answer: A \ud83d\uddf3\ufe0f"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "The Start-AzureStorageBlobCopy cmdlet starts to copy a blob."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Example 1: Copy a named blob -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "C:\\PS>Start-AzureStorageBlobCopy -SrcBlob \"ContosoPlanning2015\" -DestContainer \"ContosoArchives\" -SrcContainer \"ContosoUploads\""
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "This command starts the copy operation of the blob named ContosoPlanning2015 from the container named ContosoUploads to the container named"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ContosoArchives."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "References:"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "https://docs.microsoft.com/en-us/powershell/module/azure.storage/start-azurestorageblobcopy?view=azurermps-6.13.0"
          }
        ]
      },
      "Explanation": {
        "content": [
          {
            "type": "text",
            "value": "The Start-AzureStorageBlobCopy cmdlet starts to copy a blob."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "Example 1: Copy a named blob -"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "C:\\PS>Start-AzureStorageBlobCopy -SrcBlob \"ContosoPlanning2015\" -DestContainer \"ContosoArchives\" -SrcContainer \"ContosoUploads\""
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "This command starts the copy operation of the blob named ContosoPlanning2015 from the container named ContosoUploads to the container named"
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "ContosoArchives."
          },
          {
            "type": "break"
          },
          {
            "type": "text",
            "value": "References:"
