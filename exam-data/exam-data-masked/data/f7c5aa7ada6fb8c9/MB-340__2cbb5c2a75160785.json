      "Question": {
        "content": [
          {
            "type": "text",
            "value": "A company has recently deployed Microsoft Dynamics 365 Finance. You have been hired as a Systems Administrator. Your role will include the management of the Dynamics 365 system."
          },
          {
            "type": "break"
